rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && profile().active == true; }
    function admin() { return active() && profile().role == 'admin'; }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow write: if false;
    }
    match /farms/{id} { allow read: if active(); allow write: if false; }
    match /products/{id} { allow read: if active() && (resource.data.archived == false || admin()); allow write: if false; }
    match /categories/{id} { allow read: if active(); allow write: if false; }
    match /orders/{id} {
      allow read: if active() && (admin() || resource.data.customerId == request.auth.uid ||
        (profile().role == 'farmer' && resource.data.farmerId == request.auth.uid));
      allow write: if false;
    }
    match /adminActivityLogs/{id} { allow read: if admin(); allow write: if false; }
    match /feedback/{id} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
